# Server Configuration
PORT=5002
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MySQL / PostgreSQL)
DATABASE_URL="mysql://username:password@localhost:3306/nexus_exam_db"

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# Optional Initial Super Admin Setup (Seeds only if no superadmin exists in DB)
SUPERADMIN_NAME="Super Administrator"
SUPERADMIN_EMAIL="admin@yourinstitution.edu"
SUPERADMIN_PASSWORD="StrongSuperAdminPassword123!"

# Redis (Optional - leave empty for high-speed zero-cost in-memory mode)
REDIS_URL=""
ENABLE_BULLMQ=false
ENABLE_SOCKET_REDIS=false

# Email Notification Service (Nodemailer)
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_app_specific_password
SMTP_SERVICE=gmail

# Code Execution Engine (Judge0 RapidAPI or Self-Hosted)
USE_JUDGE0=true
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key
