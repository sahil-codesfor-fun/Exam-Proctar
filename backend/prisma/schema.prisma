generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  password              String
  name                  String
  role                  String                 @default("student")
  status                String                 @default("ACTIVE")
  mustChangePassword    Boolean                @default(false)
  studentId             String?
  facultyId             String?                @unique
  department            String?
  departmentId          String?
  course                String?
  section               String?
  designation           String?
  qualification         String?
  experience            Int?
  phone                 String?
  leetcodeUsername      String?
  isActive              Boolean                @default(true)
  passwordResetRequired Boolean                @default(false)
  lastLogin             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  submissions           Submission[]
  violations            Violation[]
  examsCreated          Exam[]
  codingMetrics         StudentCodingMetrics[]

  departmentRel    Department?      @relation("DepartmentUsers", fields: [departmentId], references: [id])
  departmentHeadOf Department?      @relation("DepartmentHead")
  subjectsTeaching TeacherSubject[] @relation("TeacherSubjects")
  activityLogs     ActivityLog[]
  loginHistory     LoginHistory[]
  notifications    Notification[]
}

model Exam {
  id                 String       @id @default(uuid())
  title              String
  description        String?      @db.Text
  course             String?
  targetBatch        String?
  targetSection      String?
  startTime          DateTime?
  endTime            DateTime?
  durationMinutes    Int
  status             String       @default("draft")
  randomizeQuestions Boolean      @default(false)
  questionsToServe   Int?
  proctoringRules    Json?
  createdAt          DateTime     @default(now())
  creatorId          String
  creator            User         @relation(fields: [creatorId], references: [id])
  questions          Question[]
  submissions        Submission[]
  violations         Violation[]
}

model Question {
  id               String         @id @default(uuid())
  examId           String
  type             String
  title            String
  description      String         @db.Text
  points           Int
  constraints      String?        @db.Text
  timeLimitSeconds Int
  exam             Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  options          Option[]
  testCases        TestCase[]
  matchingPairs    MatchingPair[]
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model TestCase {
  id             String   @id @default(uuid())
  questionId     String
  input          String   @db.Text
  expectedOutput String   @db.Text
  isHidden       Boolean
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model MatchingPair {
  id         String   @id @default(uuid())
  questionId String
  leftItem   String
  rightItem  String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Submission {
  id             String    @id @default(uuid())
  examId         String
  studentId      String
  answers        Json
  totalScore     Int       @default(0)
  maxScore       Int       @default(0)
  percentage     Float     @default(0)
  violationCount Int       @default(0)
  status         String    @default("in_progress")
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student        User      @relation(fields: [studentId], references: [id])
}

model Violation {
  id        String   @id @default(uuid())
  examId    String
  studentId String
  type      String
  severity  String
  details   String?
  timestamp DateTime @default(now())
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id])
}

// Highly Optimized Metrics Table
model StudentCodingMetrics {
  id           String @id @default(uuid())
  studentId    String
  platform     String
  totalSolved  Int    @default(0)
  easySolved   Int    @default(0)
  mediumSolved Int    @default(0)
  hardSolved   Int    @default(0)
  ranking      Int    @default(0)

  // 🚀 NEW TRACKER FIELDS: Stores snapshot counts to calculate delta differences
  weekStartCount  Int @default(0)
  monthStartCount Int @default(0)

  lastUpdated DateTime @default(now())
  user        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, platform])
  @@index([studentId])
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?  @db.Text
  email       String?
  phone       String?
  building    String?
  floor       String?
  status      String   @default("ACTIVE")
  headId      String?  @unique
  head        User?    @relation("DepartmentHead", fields: [headId], references: [id])
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users    User[]    @relation("DepartmentUsers")
  subjects Subject[]
}

model Subject {
  id       String @id @default(uuid())
  name     String
  code     String @unique
  semester Int?
  credits  Int?
  status   String @default("active")

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  teachers TeacherSubject[] @relation("TeacherSubjects")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeacherSubject {
  teacherId String
  subjectId String
  teacher   User    @relation("TeacherSubjects", fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation("TeacherSubjects", fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
}

model ActivityLog {
  id             String   @id @default(uuid())
  action         String
  entity         String
  entityId       String?
  details        String?  @db.Text
  ipAddress      String?
  userAgent      String?
  status         String   @default("success")
  previousValues Json?
  newValues      Json?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  timestamp      DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model UniversitySettings {
  id           String   @id @default(uuid())
  name         String   @default("Nexus University")
  logo         String?
  academicYear String?
  semester     String?
  timezone     String   @default("UTC")
  smtpConfig   Json?
  backupEmail  String?
  updatedAt    DateTime @updatedAt
}

model LoginHistory {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginTime  DateTime  @default(now())
  logoutTime DateTime?
  ipAddress  String?
  browser    String?
  os         String?
  deviceType String?
}
