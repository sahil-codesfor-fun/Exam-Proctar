{
  "name": "nexus-backend",
  "version": "1.0.0",
  "description": "Backend for Nexus Proctor",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "npx prisma db push --accept-data-loss && node server.js",
    "dev": "nodemon server.js",
    "build": "npx prisma generate && node prisma/seedSuperAdmin.js",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.22.5",
    "node-cron": "^4.5.0",
    "nodemailer": "^8.0.7",
    "nodemon": "^3.1.14",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0"
  }
}
